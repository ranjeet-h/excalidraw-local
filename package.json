{
  "name": "vite-tauri-node-rust-templete",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:db\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:tauri": "concurrently \"npm run dev:db\" \"npm run dev:backend\" \"npx tauri dev\"",
    "dev:frontend": "vite",
    "dev:backend": "nodemon --watch backend/src --ext ts,json --exec \"tsx backend/src/server.ts\"",
    "dev:db": "mongod --dbpath ./local_dev_data",
    "build": "tsc -b && vite build",
    "build:release-assets": "npm run setup:binaries && npm run build:backend && npm run build",
    "build:tauri": "npx tauri build",
    "build:backend": "node scripts/build-backend.js",
    "setup:binaries": "node scripts/download-mongodb.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node backend/dist/server.js",
    "swagger:generate": "swagger-jsdoc -d backend/swaggerDef.js backend/src/routes/*.ts -o backend/src/docs/swagger.json",
    "gen:api": "openapi-ts && prettier --write src/api/generated"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@fontsource-variable/noto-sans": "^5.2.10",
    "@hey-api/client-axios": "^0.9.1",
    "@tabler/icons-react": "^3.37.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.13.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "embla-carousel-react": "^8.6.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "input-otp": "^1.4.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.15.4",
    "shadcn": "^3.8.5",
    "sonner": "^2.0.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@hey-api/openapi-ts": "^0.90.10",
    "@tauri-apps/cli": "^2.10.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/morgan": "^1.9.9",
    "@types/node": "^24.11.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "nodemon": "^3.1.9",
    "openapi-typescript": "^7.13.0",
    "pkg": "^5.8.1",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.0-beta.13"
  },
  "overrides": {
    "vite": "^8.0.0-beta.13"
  }
}
