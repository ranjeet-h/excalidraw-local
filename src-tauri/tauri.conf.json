{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "vite-tauri-node-rust-templete",
  "version": "0.1.0",
  "identifier": "com.vite-tauri-node-rust.template",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:release-assets"
  },
  "app": {
    "windows": [
      {
        "title": "vite-tauri-node-rust-templete",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/mongod",
      "bin/backend"
    ]
  }
}
